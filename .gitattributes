# Default text normalization
* text=auto

# Source, configuration, documentation and evidence text
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Binary document fixtures
*.pdf binary

# Archives and images, if added later
*.gz   binary
*.zip  binary
*.png  binary
*.jpg  binary
*.jpeg binary
